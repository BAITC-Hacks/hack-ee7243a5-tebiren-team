# Copy to backend/.env locally. Never commit this file with secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Alternatively REMOVE OPENAI_API_KEY above and explicitly set a local key file:
# OPENAI_API_KEY_FILE=API key.txt
# Optional overrides; defaults are suitable for npm run dev.
# CQ_DATABASE_PATH=C:/path/to/local/career-quest.sqlite3
# CQ_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# CQ_SECURE_COOKIES=true  # only with HTTPS
# Prefer npm run setup:demo to store hashed local passwords in SQLite.
# Optional CI/demo provisioning; passwords must be at least 12 characters.
# CQ_HR_PASSWORD=
# CQ_EMPLOYEE_PASSWORD=
# CQ_EMPLOYEE_ID=E0002
