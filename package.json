    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "autoprefixer": "10.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
